PORT=4000
HOST=127.0.0.1
BROWSER_CHANNEL=
BROWSER_HEADLESS=1
PAGE_SETTLE_MS=750
MAX_PAGES=4
# Only for the bundled local demo and local tests.
ALLOW_PRIVATE_TARGETS=0

# Persona simulation. Without LLM_API_KEY the deterministic heuristic policy is used
# (no network calls, reproducible from a seed). With a key, agents decide each step through an
# OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, a local server, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Parallel browser sessions per simulation (1-6) and steps per session (2-30); the request body can override both.
SIM_CONCURRENCY=3
SIM_MAX_STEPS=12
# Use your own persona pool instead of server/data/personas.json (same JSON shape, see server/data/PERSONAS-SOURCE.md).
PERSONA_POOL_PATH=

# Site-matched persona generation (POST /api/runs/:id/personas). Without a key the site character and
# archetypes come from keyword/CTA/title heuristics; with LLM_API_KEY both are derived by the LLM as JSON.
# Sampling uses the bundled pool unless NEMOTRON_PERSONAS_PATH points at a local JSONL export of
# nvidia/Nemotron-Personas-Korea (see README, "Site-matched personas"); the dataset is not bundled.
NEMOTRON_PERSONAS_PATH=
# Rows read from that export (memory bound).
NEMOTRON_MAX_ROWS=50000

# Live agent view (GET /api/runs/:id/simulation/live, server-sent events with CDP screencast frames).
LIVE_FPS=5
LIVE_JPEG_QUALITY=50
LIVE_MAX_WIDTH=960
