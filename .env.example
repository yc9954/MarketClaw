PORT=4000
HOST=127.0.0.1
BROWSER_CHANNEL=
BROWSER_HEADLESS=1
PAGE_SETTLE_MS=750
MAX_PAGES=4
# Only for the bundled local demo and local tests.
ALLOW_PRIVATE_TARGETS=0

# Persona simulation. Without LLM_API_KEY the deterministic heuristic policy is used
# (no network calls, reproducible from a seed). With a key, agents decide each step through an
# OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, a local server, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Parallel browser sessions per simulation (1-6) and steps per session (2-30); the request body can override both.
SIM_CONCURRENCY=3
SIM_MAX_STEPS=12
# Use your own persona pool instead of server/data/personas.json (same JSON shape, see server/data/PERSONAS-SOURCE.md).
PERSONA_POOL_PATH=
